class FONT_Enh_PlainSmall extends GUI.GUIFont
	instanced;

// A plain face for a menu caption that the ink faces cannot fit on its page (SAPFont.int / SAPFont.rus: EnhPlain12=Tahoma, EnhPlain12Size=12; written by the setup).

defaultproperties
{
	KeyName="FontEnhPlainSmall"
	FontArrayNames(0)="EnhPlain12"
	FontArrayNames(1)="EnhPlain12"
	FontArrayNames(2)="EnhPlain12"
	FontArrayNames(3)="EnhPlain12"
	FontArrayNames(4)="EnhPlain12"
	FontArrayNames(5)="EnhPlain12"
	FontArrayNames(6)="EnhPlain12"
	FontArrayNames(7)="EnhPlain12"
}
