class FONT_Enh_Shrek extends GUI.GUIFont
	instanced;

// The "Shrek" face for the headings: a system font made by the engine at run time (SAPFont.int / SAPFont.rus: ShrekTitle=Shrek and its size);
// the engine layer loads Shrekrusbyme.ttf into the game process privately, so the font need not be installed in Windows.

defaultproperties
{
	KeyName="FontEnhShrek"
	FontArrayNames(0)="ShrekTitle"
	FontArrayNames(1)="ShrekTitle"
	FontArrayNames(2)="ShrekTitle"
	FontArrayNames(3)="ShrekTitle"
	FontArrayNames(4)="ShrekTitle"
	FontArrayNames(5)="ShrekTitle"
	FontArrayNames(6)="ShrekTitle"
	FontArrayNames(7)="ShrekTitle"
}
