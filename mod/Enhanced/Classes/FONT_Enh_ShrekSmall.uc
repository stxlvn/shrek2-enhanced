class FONT_Enh_ShrekSmall extends GUI.GUIFont
	instanced;

// A smaller "Shrek" face for headings that do not fit their page (SAPFont.int / SAPFont.rus: ShrekTitleSmall=Shrek, ShrekTitleSmallSize=22; written by the setup).

defaultproperties
{
	KeyName="FontEnhShrekSmall"
	FontArrayNames(0)="ShrekTitleSmall"
	FontArrayNames(1)="ShrekTitleSmall"
	FontArrayNames(2)="ShrekTitleSmall"
	FontArrayNames(3)="ShrekTitleSmall"
	FontArrayNames(4)="ShrekTitleSmall"
	FontArrayNames(5)="ShrekTitleSmall"
	FontArrayNames(6)="ShrekTitleSmall"
	FontArrayNames(7)="ShrekTitleSmall"
}
