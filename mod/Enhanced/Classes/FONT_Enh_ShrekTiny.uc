class FONT_Enh_ShrekTiny extends GUI.GUIFont
	instanced;

// A smaller "Shrek" face for headings that do not fit their page (SAPFont.int / SAPFont.rus: ShrekTitleTiny=Shrek, ShrekTitleTinySize=17; written by the setup).

defaultproperties
{
	KeyName="FontEnhShrekTiny"
	FontArrayNames(0)="ShrekTitleTiny"
	FontArrayNames(1)="ShrekTitleTiny"
	FontArrayNames(2)="ShrekTitleTiny"
	FontArrayNames(3)="ShrekTitleTiny"
	FontArrayNames(4)="ShrekTitleTiny"
	FontArrayNames(5)="ShrekTitleTiny"
	FontArrayNames(6)="ShrekTitleTiny"
	FontArrayNames(7)="ShrekTitleTiny"
}
